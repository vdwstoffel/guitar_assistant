# Caddyfile — HTTPS reverse proxy in front of the Next.js app.
#
# `tls internal` makes Caddy issue certificates from its own local CA, which
# lives in the `caddy_data` volume at /data/caddy/pki/authorities/local/.
# The certificates are perfectly valid; they are simply signed by an authority
# no device trusts out of the box, which is why browsers show
# ERR_CERT_AUTHORITY_INVALID on a first visit.
#
# The fix is to trust that authority once per machine, NOT to replace the
# certificate. Run scripts/install-ca.sh (Linux/macOS) or scripts/install-ca.ps1
# (Windows) on each machine on the LAN; both fetch the root CA from the
# /rootca.crt route below and install it into the system and browser stores.
#
# Two things invalidate every installed copy, so avoid them:
#   - deleting the `caddy_data` volume (Caddy mints a brand-new root CA)
#   - changing the LAN IP below (certificates are bound to it — pin the address
#     with a DHCP reservation on the router)
{
	admin off
	# If the client doesn't send SNI (some browsers/clients omit it for raw
	# IPs), fall back to the LAN IP cert so the handshake still succeeds.
	default_sni 192.168.129.11
}

# Add additional hostnames/IPs here as needed.
https://192.168.129.11, https://localhost {
	tls internal

	# Stream large audio/PDF files without buffering them in memory.
	reverse_proxy nextjs-app:3000 {
		flush_interval -1
	}
}

# An explicit http:// site for these hosts, which also suppresses Caddy's
# automatic HTTP->HTTPS redirect for them. That redirect is host-matched, so it
# sorts ahead of a catch-all `:80` block and would otherwise shadow /rootca.crt.
http://192.168.129.11, http://localhost {
	# Serve the local CA over plain HTTP, so a machine that does not trust it
	# yet can still fetch it without hitting the very warning it is meant to
	# cure.
	#
	# Only the exact path /rootca.crt reaches the file_server, and the URI is
	# rewritten to a fixed path, so the rest of /data stays unreachable.
	# The install scripts check the file's SHA-256 against a pinned value, so
	# serving it unencrypted does not let anyone substitute their own CA.
	handle /rootca.crt {
		header Content-Type application/x-x509-ca-cert
		rewrite * /caddy/pki/authorities/local/root.crt
		file_server {
			root /data
		}
	}

	# Everything else goes to HTTPS, as before.
	handle {
		redir https://{host}{uri} permanent
	}
}

# Any other name pointed at this box still gets bounced to HTTPS.
:80 {
	redir https://{host}{uri} permanent
}
