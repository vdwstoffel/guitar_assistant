generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Author {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]
}

model Book {
  id         String      @id @default(uuid())
  name       String
  authorId   String
  pdfPath    String?
  coverPath  String?
  inProgress Boolean     @default(false)
  author     Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tracks     Track[]
  videos     BookVideo[]
  chapters   Chapter[]

  @@unique([name, authorId])
}

model Chapter {
  id        String      @id @default(uuid())
  name      String
  bookId    String
  sortOrder Int         @default(0)
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tracks    Track[]
  videos    BookVideo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([bookId])
}

model Track {
  id            String   @id @default(uuid())
  title         String
  trackNumber   Int
  filePath      String   @unique
  duration      Float
  bookId        String
  chapterId     String?
  sortOrder     Int      @default(0)
  pdfPage       Int?
  completed     Boolean  @default(false)
  inProgress    Boolean  @default(false)
  favorite      Boolean  @default(false)
  lastPlayedAt  DateTime?
  completedAt   DateTime?
  tempo         Int?
  timeSignature String   @default("4/4")
  playbackSpeed Int?
  volume        Int?
  lufs          Float?
  notes         String?
  sourceVideoId     String?  @unique
  markers           Marker[]
  tabs              TrackTab[]
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter           Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sourceVideo       BookVideo? @relation("ExtractedAudio", fields: [sourceVideoId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([chapterId])
}

model Marker {
  id        String @id @default(uuid())
  name      String
  timestamp Float
  pdfPage   Int?
  trackId   String
  track     Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model TrackTab {
  id        String  @id @default(uuid())
  name      String
  alphatex  String?
  tempo     Int     @default(120)
  sortOrder Int     @default(0)
  trackId   String
  track     Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model BookVideo {
  id               String            @id @default(uuid())
  filename         String
  title            String?
  filePath         String            @unique
  duration         Float?
  sortOrder        Int               @default(0)
  trackNumber      Int?
  pdfPage          Int?
  completed        Boolean           @default(false)
  inProgress       Boolean           @default(false)
  lastPlayedAt     DateTime?
  completedAt      DateTime?
  notes            String?
  bookId           String
  chapterId        String?
  book             Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter          Chapter?          @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  extractedTrack   Track?            @relation("ExtractedAudio")
  markers          BookVideoMarker[]
  createdAt   DateTime @default(now())

  @@index([bookId])
  @@index([chapterId])
}

model Video {
  id               String            @id @default(uuid())
  title            String
  youtubeId        String
  sortOrder        Int               @default(0)
  category         String?
  completed        Boolean           @default(false)
  inProgress       Boolean           @default(false)
  lastPlayedAt     DateTime?
  completedAt      DateTime?
  notes            String?
  localPath        String?
  duration         Float?
  status           String            @default("pending")
  errorMessage     String?
  createdAt        DateTime          @default(now())
  markers          VideoMarker[]
}

model VideoMarker {
  id        String @id @default(uuid())
  name      String
  timestamp Float
  videoId   String
  video     Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model BookVideoMarker {
  id          String    @id @default(uuid())
  name        String
  timestamp   Float
  bookVideoId String
  bookVideo   BookVideo @relation(fields: [bookVideoId], references: [id], onDelete: Cascade)

  @@index([bookVideoId])
}

model JamTrack {
  id            String           @id @default(uuid())
  title         String
  filePath      String           @unique
  duration      Float
  completed     Boolean          @default(false)
  inProgress    Boolean          @default(false)
  favorite      Boolean          @default(false)
  lastPlayedAt  DateTime?
  completedAt   DateTime?
  tempo         Int?
  timeSignature String           @default("4/4")
  playbackSpeed Int?
  volume        Int?
  lufs          Float?
  gpFilePath    String?
  markers           JamTrackMarker[]
  createdAt         DateTime         @default(now())
}

model JamTrackMarker {
  id         String   @id @default(uuid())
  name       String
  timestamp  Float
  jamTrackId String
  jamTrack   JamTrack @relation(fields: [jamTrackId], references: [id], onDelete: Cascade)

  @@index([jamTrackId])
}

model GuitarTab {
  id            String   @id @default(uuid())
  title         String
  filePath      String   @unique
  tempo         Int?
  timeSignature String?
  duration      Float?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Recording {
  id        String   @id @default(uuid())
  title     String
  filePath  String   @unique
  duration  Float
  mimeType  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}


model BackingTrack {
  id           String   @id @default(uuid())
  youtubeUrl   String   @unique
  videoId      String
  title        String
  thumbnailUrl String?
  audioPath    String?
  duration     Float?
  rootNote     String
  scaleType    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
